{
  "name": "@sentinel/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@sentinel/core": "workspace:*",
    "@sentinel/db": "workspace:*",
    "@sentinel/github": "workspace:*",
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0",
    "pino": "^10.4.0",
    "semver": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/semver": "^7.7.0",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
